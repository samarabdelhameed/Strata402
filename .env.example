# ==============================================================================
# Strata402 — Environment Blueprint (Phase 7A snapshot)
# Development/reference values only. NEVER commit real private keys or secrets.
# Copy to .env locally before running services.
# ==============================================================================

# ===== Hedera testnet =====
HEDERA_NETWORK=testnet
STRATA_NETWORK=hedera:testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ===== Service/resource account (payTo for the x402 exact scheme) =====
# Development placeholder — fund a real testnet account before production runs.
HEDERA_SERVICE_ACCOUNT_ID=0.0.1234
HEDERA_SERVICE_ACCOUNT_KEY=...placeholder...

# ===== x402 facilitator (Blocky402) =====
# The public facilitator advertises `exact` on hedera:testnet with feePayer 0.0.9185802.
X402_FACILITATOR_URL=https://x402.org/facilitator

# ===== x402 pricing =====
X402_PRICE_TINYBARS=1000000
X402_ASSET=0.0.0

# ===== Consuming agent buyer (Phase 4) =====
BUYER_ACCOUNT_ID=0.0.PLACEHOLDER
BUYER_PRIVATE_KEY=...placeholder...

# ===== Yield-risk analysis contract (Phase 7A) =====
# Consumed by the paid /v1/strategy/yield-risk endpoint. Defaults are safe.
STRATA402_RISK_TOLERANCE=balanced
STRATA402_ANALYSIS_AMOUNT_HBAR=1

# ===== SaucerSwap (Phase 7) — PENDING =====
# Waiting for an official API key and a live Testnet probe.
# Keep empty: no fake keys, no unofficial sources, no adapter before the key arrives.
SAUCERSWAP_API_KEY=
SAUCERSWAP_API_URL=https://test-api.saucerswap.finance

# ===== AI provider (Phase 4) =====
LLM_PROVIDER=...placeholder...
LLM_API_KEY=...placeholder...
LLM_MODEL=...placeholder...

# ===== Local dev =====
PORT=8080
AI_ENGINE_URL=http://localhost:8000

# NOTE: never paste account private keys into .env.example. Real keys live only
# in the git-ignored local .env (and must be rotated if ever exposed).
