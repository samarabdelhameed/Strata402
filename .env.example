# ==============================================================================
# Strata402 — Environment Blueprint
# Development/reference values only. NEVER commit real private keys or secrets.
# Copy to .env locally before running services.
# ==============================================================================

# ===== Hedera testnet =====
HEDERA_NETWORK=testnet
STRATA_NETWORK=hedera:testnet
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ===== Service/resource account (payTo for the x402 exact scheme) =====
# Development placeholder — fund a real testnet account before production runs.
HEDERA_SERVICE_ACCOUNT_ID=0.0.1234
HEDERA_SERVICE_ACCOUNT_KEY=...placeholder...

# ===== Payer (consuming agent C1 / web paid flow, funded buyer) =====
# Server-only. Never reach the browser; the Web UI signs entirely server-side.
STRATA402_PAYER_ACCOUNT_ID=0.0.1234
STRATA402_PAYER_PRIVATE_KEY=...placeholder...

# ===== x402 facilitator (Blocky402) =====
# The public facilitator advertises `exact` on hedera:testnet with feePayer 0.0.9185802.
X402_FACILITATOR_URL=https://x402.org/facilitator

# ===== x402 pricing =====
X402_PRICE_TINYBARS=1000000
X402_ASSET=0.0.0

# ===== Gateway / mirror wiring (used by gateway, agent and web) =====
STRATA402_SERVICE_URL=http://127.0.0.1:8080
STRATA402_GATEWAY_BASE_URL=http://127.0.0.1:8080
STRATA402_MIRROR_BASE_URL=https://testnet.mirrornode.hedera.com
STRATA402_ALLOWED_PAYTO=0.0.1234

# ===== Autonomous payer safety gates (fail-closed) =====
STRATA402_RUN_C0=false
STRATA402_RUN_C0_PAYLOAD=false
STRATA402_RUN_C1=false
STRATA402_C1_CONFIRM=false
STRATA402_MAX_PER_REQUEST_TINYBARS=1000000
STRATA402_MAX_TOTAL_BUDGET_TINYBARS=1000000

# ===== Yield-risk analysis contract =====
# Consumed by the paid /v1/strategy/yield-risk endpoint. Defaults are safe.
STRATA402_RISK_TOLERANCE=balanced
STRATA402_ANALYSIS_AMOUNT_HBAR=1

# ===== SaucerSwap (Phase 7) — PENDING =====
# Waiting for an official API key and a live Testnet probe.
# Keep empty: no fake keys, no unofficial sources, no adapter before the key arrives.
SAUCERSWAP_API_KEY=
SAUCERSWAP_API_URL=https://test-api.saucerswap.finance

# ===== HCS audit log topic (Phase 8F) =====
# Created live on testnet; fill with the real 0.0.x id. The gateway/audit logger
# submits only safe metadata (requestId, endpoint, status, txId, block timestamp)
# — never secrets.
HCS_AUDIT_TOPIC_ID=
STRATA402_HCS_CREATE=false

# ===== AI provider (hooks, disabled unless all three are set) =====
# The deterministic engine never depends on the LLM.
LLM_PROVIDER=...placeholder...
LLM_API_KEY=...placeholder...
LLM_MODEL=...placeholder...

# ===== Local dev =====
PORT=8080
AI_ENGINE_URL=http://localhost:8000

# NOTE: never paste account private keys into .env.example. Real keys live only
# in the git-ignored local .env (and must be rotated if ever exposed).