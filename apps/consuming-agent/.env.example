# Strata402 consuming-agent — environment placeholders only.
# Never commit or set real credentials here.
#
# Phase 4.4-A safety configuration (no signing, no payment in this phase).

STRATA402_NETWORK=hedera:testnet
STRATA402_MAX_PER_REQUEST_TINYBARS=1000000
STRATA402_MAX_TOTAL_BUDGET_TINYBARS=100000000
# Required only in payer-readiness / signing modes.
STRATA402_PAYER_ACCOUNT_ID=
# Local payer private key (Phase 4.4-B1 uses it for local payload construction
# only). Never set real credentials here; keep them in the local, git-ignored
# `.env` file. Supports ED25519 or ECDSA (raw hex, 0x-prefixed hex, or DER hex).
# STRATA402_PAYER_PRIVATE_KEY=