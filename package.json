{
  "name": "strata402",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous DeFi Intelligence on Hedera — x402-powered AI DeFi strategy service for autonomous agents on Hedera",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "validate": "bun run scripts/validate-workspaces.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun --cwd apps/web run typecheck",
    "preflight:c0": "bun apps/consuming-agent/src/cli-c0.ts",
    "preflight:c0:payload": "bun apps/consuming-agent/src/cli-c0-payload.ts",
    "preflight:c1": "bun apps/consuming-agent/src/cli-c1-paid.ts",
    "hcs:create-topic": "bun apps/consuming-agent/src/create-hcs-topic.ts",
    "dev": "bun services/api-gateway/src/index.ts",
    "dev:gateway": "bun services/api-gateway/src/index.ts",
    "dev:ai-engine": "cd services/ai-engine && python -m uvicorn app.main:app --reload --port 8000",
    "dev:web": "bun --cwd apps/web dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@x402/core": "2.25.0",
    "@x402/express": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/hedera": "2.25.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  }
}